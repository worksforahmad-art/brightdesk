# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Environment Variables (never commit real secrets) ─────────────────────────
.env
.env.local
.env.*.local

# ── Database files (contain real user data — keep out of Git) ─────────────────
*.db
*.db-shm
*.db-wal
backend/database/*.db
backend/database/*.db-shm
backend/database/*.db-wal

# ── OS & Editor files ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
*.log

# Extra local database and development backups
*.sqlite
*.sqlite3
*.db-journal
*.backup
brightdesk-backup*/
