# ── BrightDesk Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# Never commit the real .env file to Git.

# A long, random secret string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-secret-string

# The port the server will listen on.
PORT=3000

# Set to "production" on a live server for secure cookies.
NODE_ENV=development
