# ── BrightDesk Environment Variables ─────────────────────────────────────────
# Copy this file to .env for local development.
# In Railway production, set these in Railway Dashboard > Variables.
# Never commit the real .env file to Git.

# A long, random secret string used to sign session cookies (REQUIRED in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-secret-string

# Port to listen on (Railway provides this automatically via $PORT).
PORT=3000

# Set to "production" on Railway for HTTPS secure cookies.
NODE_ENV=development

# Path to SQLite database file.
# Local development default: backend/database/brightdesk.db
# Railway with persistent volume mounted at /data: /data/brightdesk.db
DATABASE_PATH=backend/database/brightdesk.db
