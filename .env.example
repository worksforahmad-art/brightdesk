# ── BrightDesk Environment Variables ─────────────────────────────────────────
# Copy this file to .env for local development.
# In Railway production, set these in Railway Dashboard > Variables.
# Never commit the real .env file to Git.

# A long, random secret string used to sign session cookies (REQUIRED in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-secret-string

# Port to listen on (Railway provides this automatically via $PORT).
PORT=3000

# Set to "production" on Railway for HTTPS secure cookies.
NODE_ENV=development

# Path to SQLite database file.
# Local development default: backend/database/brightdesk.db
# Railway with persistent volume mounted at /data: /data/brightdesk.db
DATABASE_PATH=backend/database/brightdesk.db

# --- Supabase PostgreSQL (optional: leave unset to use SQLite) ---
# Set only on the Railway backend, after running the SQL migration in Supabase.
# Copy the actual SESSION POOLER URL from Supabase > Connect (port 5432).
# Never commit the real connection URL/password or put it in frontend JS.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
# TLS and certificate verification are enabled automatically when DATABASE_URL exists.
# Optional PEM CA certificate from Supabase > Database Settings > SSL Configuration.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
# DATABASE_SSL=false   # ONLY for a trusted local PostgreSQL test server; NEVER production.
